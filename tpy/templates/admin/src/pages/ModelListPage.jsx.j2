import { useEffect, useMemo, useState } from "react";
import { Link } from "react-router-dom";
import { deleteRecord, listRecords } from "../api/client.js";
import DataTable from "../components/DataTable.jsx";
import PageHeader from "../components/PageHeader.jsx";
import StatusMessage from "../components/StatusMessage.jsx";

const PAGE_SIZE = 10;

export default function ModelListPage({ model }) {
  const [records, setRecords] = useState([]);
  const [page, setPage] = useState(1);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  async function loadRecords() {
    setLoading(true);
    setError("");
    try {
      const rows = await listRecords(model.routePrefix);
      setRecords(Array.isArray(rows) ? rows : []);
      setPage(1);
    } catch (loadError) {
      setError(loadError.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadRecords();
  }, [model.routePrefix]);

  const totalPages = Math.max(1, Math.ceil(records.length / PAGE_SIZE));
  const visibleRecords = useMemo(() => {
    const start = (page - 1) * PAGE_SIZE;
    return records.slice(start, start + PAGE_SIZE);
  }, [records, page]);

  async function handleDelete(record) {
    const id = record[model.primaryName];
    if (!window.confirm(`Delete ${model.name} ${id}?`)) {
      return;
    }

    try {
      await deleteRecord(model.routePrefix, id);
      await loadRecords();
    } catch (deleteError) {
      setError(deleteError.message);
    }
  }

  return (
    <section>
      <PageHeader
        title={model.name}
        subtitle={`${records.length} record${records.length === 1 ? "" : "s"}`}
        actions={
          <Link className="button" to={`/${model.routePrefix}/new`}>
            New {model.name}
          </Link>
        }
      />

      {loading ? <StatusMessage>Loading {model.name} records...</StatusMessage> : null}
      <StatusMessage tone="error">{error}</StatusMessage>

      {!loading ? (
        <DataTable
          fields={model.fields}
          records={visibleRecords}
          primaryName={model.primaryName}
          resource={model.routePrefix}
          onDelete={handleDelete}
        />
      ) : null}

      {records.length > PAGE_SIZE ? (
        <div className="pagination">
          <button
            className="secondary"
            type="button"
            disabled={page === 1}
            onClick={() => setPage(page - 1)}
          >
            Previous
          </button>
          <span>
            Page {page} of {totalPages}
          </span>
          <button
            className="secondary"
            type="button"
            disabled={page === totalPages}
            onClick={() => setPage(page + 1)}
          >
            Next
          </button>
        </div>
      ) : null}
    </section>
  );
}
