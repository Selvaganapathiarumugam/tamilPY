import { useState } from "react";
import { Navigate, useNavigate } from "react-router-dom";
import { login } from "../api/client.js";
import {
  canAccessDashboard,
  isLoggedIn,
  parseJwtPayload,
  saveSession,
} from "../auth/session.js";
import StatusMessage from "../components/StatusMessage.jsx";

export default function LoginPage() {
  const navigate = useNavigate();
  const [email, setEmail] = useState("admin@example.com");
  const [password, setPassword] = useState("admin123");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);

  if (isLoggedIn() && canAccessDashboard()) {
    return <Navigate to="/" replace />;
  }

  async function onSubmit(event) {
    event.preventDefault();
    setBusy(true);
    setError("");
    try {
      const tokens = await login(email, password);
      const payload = parseJwtPayload(tokens.access_token);
      const role = payload?.role || "";
      saveSession({
        access_token: tokens.access_token,
        refresh_token: tokens.refresh_token,
        role,
      });
      if (!canAccessDashboard(role)) {
        setError(
          "Access denied. Admin dashboard is only for super-admin and developer.",
        );
        return;
      }
      navigate("/", { replace: true });
    } catch (err) {
      setError(err.message || "Login failed");
    } finally {
      setBusy(false);
    }
  }

  return (
    <div className="login-page">
      <form className="login-card" onSubmit={onSubmit}>
        <p className="eyebrow">TPY Admin</p>
        <h1>Sign in</h1>
        <p className="muted">Use your JWT account to open the dashboard.</p>
        <StatusMessage tone="error">{error}</StatusMessage>
        <label>
          Email
          <input
            type="email"
            value={email}
            onChange={(event) => setEmail(event.target.value)}
            required
          />
        </label>
        <label>
          Password
          <input
            type="password"
            value={password}
            onChange={(event) => setPassword(event.target.value)}
            required
          />
        </label>
        <button className="btn btn-primary" type="submit" disabled={busy}>
          {busy ? "Signing in…" : "Sign in"}
        </button>
      </form>
    </div>
  );
}
