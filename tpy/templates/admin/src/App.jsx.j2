import { Navigate, Route, Routes } from "react-router-dom";
import Layout from "./components/Layout.jsx";
import RequireAuth from "./components/RequireAuth.jsx";
import { LANDING_ROUTE_PREFIX } from "./config.js";
import { models } from "./data/models.js";
import LoginPage from "./pages/LoginPage.jsx";
import ModelFormPage from "./pages/ModelFormPage.jsx";
import ModelListPage from "./pages/ModelListPage.jsx";

export default function App() {
  const landing =
    LANDING_ROUTE_PREFIX
      ? `/${LANDING_ROUTE_PREFIX}`
      : models[0]
        ? `/${models[0].routePrefix}`
        : "/";

  return (
    <Routes>
      <Route path="/login" element={<LoginPage />} />
      <Route
        element={
          <RequireAuth>
            <Layout models={models} />
          </RequireAuth>
        }
      >
        <Route path="/" element={<Navigate to={landing} replace />} />
        {models.map((model) => (
          <Route
            key={`${model.routePrefix}-list`}
            path={`/${model.routePrefix}`}
            element={<ModelListPage model={model} />}
          />
        ))}
        {models.map((model) => (
          <Route
            key={`${model.routePrefix}-new`}
            path={`/${model.routePrefix}/new`}
            element={<ModelFormPage model={model} />}
          />
        ))}
        {models.map((model) => (
          <Route
            key={`${model.routePrefix}-edit`}
            path={`/${model.routePrefix}/:id/edit`}
            element={<ModelFormPage model={model} />}
          />
        ))}
        <Route
          path="*"
          element={
            <section>
              <h1>Not found</h1>
              <p className="muted">No admin page matches this URL.</p>
            </section>
          }
        />
      </Route>
    </Routes>
  );
}
