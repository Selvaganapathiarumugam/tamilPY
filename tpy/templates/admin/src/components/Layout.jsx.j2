import { NavLink, Outlet, useNavigate } from "react-router-dom";
import { logout } from "../api/client.js";
import { getRole } from "../auth/session.js";
import { THEME_SUBTITLE, THEME_TITLE } from "../config.js";

export default function Layout({ models }) {
  const navigate = useNavigate();
  const role = getRole();

  async function onLogout() {
    await logout();
    navigate("/login", { replace: true });
  }

  return (
    <div className="shell">
      <aside className="sidebar">
        <div className="brand">
          <span className="brand-mark">TPY</span>
          <div>
            <strong>{THEME_TITLE}</strong>
            <p className="brand-sub">{THEME_SUBTITLE}</p>
          </div>
        </div>
        <nav aria-label="Models">
          {models.length === 0 && (
            <p className="muted">No models in schema.tpy</p>
          )}
          {models.map((model) => (
            <NavLink
              key={model.routePrefix}
              to={`/${model.routePrefix}`}
              className={({ isActive }) => (isActive ? "active" : undefined)}
            >
              {model.name}
            </NavLink>
          ))}
        </nav>
        <div className="sidebar-footer">
          <p className="muted">{role || "signed in"}</p>
          <button type="button" className="secondary" onClick={onLogout}>
            Logout
          </button>
        </div>
      </aside>
      <main className="content">
        <Outlet />
      </main>
    </div>
  );
}
