:root {
  color: #1f2937;
  background: #f6f7fb;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
.button {
  align-items: center;
  background: #2563eb;
  border: 1px solid #2563eb;
  border-radius: 6px;
  color: #ffffff;
  cursor: pointer;
  display: inline-flex;
  font-weight: 600;
  gap: 0.4rem;
  min-height: 2.25rem;
  padding: 0.45rem 0.75rem;
  text-decoration: none;
}

button.secondary,
.button.secondary {
  background: #ffffff;
  border-color: #cbd5e1;
  color: #334155;
}

button.danger {
  background: #dc2626;
  border-color: #dc2626;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.shell {
  display: grid;
  grid-template-columns: 240px 1fr;
  min-height: 100vh;
}

.sidebar {
  background: #111827;
  color: #e5e7eb;
  padding: 1.25rem;
}

.brand {
  align-items: flex-start;
  display: flex;
  gap: 0.7rem;
  margin-bottom: 1.5rem;
}

.brand strong {
  display: block;
}

.brand-sub {
  color: #94a3b8;
  font-size: 0.78rem;
  margin: 0.15rem 0 0;
}

.brand-mark {
  background: #f59e0b;
  border-radius: 4px;
  color: #111827;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.3rem 0.4rem;
}

.sidebar nav {
  display: grid;
  gap: 0.35rem;
}

.sidebar a {
  border-radius: 6px;
  color: #cbd5e1;
  padding: 0.65rem 0.75rem;
  text-decoration: none;
}

.sidebar a.active,
.sidebar a:hover {
  background: #1f2937;
  color: #ffffff;
}

.content {
  min-width: 0;
  padding: 2rem;
}

.page-header {
  align-items: center;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.page-header h1 {
  font-size: 1.7rem;
  margin: 0;
}

.page-actions {
  display: flex;
  gap: 0.5rem;
}

.muted {
  color: #64748b;
}

.status {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  margin: 1rem 0;
  padding: 0.85rem 1rem;
}

.status.error {
  background: #fef2f2;
  border-color: #fecaca;
  color: #991b1b;
}

.table-wrap {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  overflow-x: auto;
}

table {
  border-collapse: collapse;
  min-width: 100%;
}

th,
td {
  border-bottom: 1px solid #e2e8f0;
  padding: 0.75rem;
  text-align: left;
  vertical-align: top;
  white-space: nowrap;
}

th {
  background: #f8fafc;
  color: #475569;
  font-size: 0.78rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.actions {
  display: flex;
  gap: 0.5rem;
}

.pagination {
  align-items: center;
  display: flex;
  gap: 0.75rem;
  justify-content: flex-end;
  margin-top: 1rem;
}

.form {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  display: grid;
  gap: 1rem;
  max-width: 720px;
  padding: 1rem;
}

.field {
  display: grid;
  gap: 0.35rem;
}

.field label {
  color: #334155;
  font-weight: 600;
}

.field input,
.field select,
.field textarea {
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  min-height: 2.4rem;
  padding: 0.5rem 0.65rem;
}

.field.checkbox {
  align-items: center;
  display: flex;
  gap: 0.6rem;
}

.field.checkbox input {
  min-height: auto;
}

.field-error {
  color: #b91c1c;
  font-size: 0.85rem;
}

.form-actions {
  display: flex;
  gap: 0.75rem;
}

@media (max-width: 760px) {
  .shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: static;
  }

  .sidebar nav {
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  }

  .content {
    padding: 1rem;
  }

  .page-header {
    align-items: stretch;
    flex-direction: column;
  }
}
