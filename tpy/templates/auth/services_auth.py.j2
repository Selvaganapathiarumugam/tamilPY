"""
Authentication business logic (JWT + roles).
"""

from __future__ import annotations

from datetime import datetime, timezone
from uuid import uuid4

import jwt
from fastapi import HTTPException, status

from app.providers.database import db
from app.security.jwt import (
    access_expires_seconds,
    create_access_token,
    create_refresh_token,
    decode_token,
    hash_password,
    verify_password,
)

REFRESH_COLLECTION = "_tpy_refresh_tokens"
DEFAULT_REGISTER_ROLE = "admin"


class AuthService:
    """Register, login, refresh, logout, and profile helpers."""

    def _is_mongo(self) -> bool:
        return hasattr(db, "collection_find_one")

    def _find_role_by_name(self, name: str) -> dict | None:
        if self._is_mongo():
            return db.collection_find_one("authrole", {"name": name})
        table = db.quote_identifier("authrole")
        col = db.quote_identifier("name")
        return db.fetch_one(
            f"SELECT * FROM {table} WHERE {col} = ?",
            (name,),
        )

    def _find_user_by_email(self, email: str) -> dict | None:
        if self._is_mongo():
            return db.collection_find_one("user", {"email": email})
        table = db.quote_identifier("user")
        col = db.quote_identifier("email")
        return db.fetch_one(
            f"SELECT * FROM {table} WHERE {col} = ?",
            (email,),
        )

    def _find_user_by_id(self, user_id: str) -> dict | None:
        if self._is_mongo():
            return db.collection_find_one("user", {"id": str(user_id)})
        table = db.quote_identifier("user")
        col = db.quote_identifier("id")
        return db.fetch_one(
            f"SELECT * FROM {table} WHERE {col} = ?",
            (str(user_id),),
        )

    def _find_role_by_id(self, role_id: str) -> dict | None:
        if self._is_mongo():
            return db.collection_find_one("authrole", {"id": str(role_id)})
        table = db.quote_identifier("authrole")
        col = db.quote_identifier("id")
        return db.fetch_one(
            f"SELECT * FROM {table} WHERE {col} = ?",
            (str(role_id),),
        )

    def _create_user(self, data: dict) -> dict | None:
        if self._is_mongo():
            db.collection_insert_one("user", data)
            return db.collection_find_one("user", {"id": data["id"]})
        table = db.quote_identifier("user")
        columns = ", ".join(db.quote_identifier(key) for key in data.keys())
        placeholders = ", ".join(["?"] * len(data))
        db.execute(
            f"INSERT INTO {table} ({columns}) VALUES ({placeholders})",
            tuple(data.values()),
        )
        return self._find_user_by_id(data["id"])

    def _ensure_refresh_store(self) -> None:
        if self._is_mongo():
            return
        db.execute(
            """
            CREATE TABLE IF NOT EXISTS _tpy_refresh_tokens (
                jti TEXT PRIMARY KEY,
                user_id TEXT NOT NULL,
                revoked INTEGER NOT NULL DEFAULT 0,
                created_at TEXT
            )
            """
        )

    def _store_refresh(self, jti: str, user_id: str) -> None:
        self._ensure_refresh_store()
        row = {
            "jti": jti,
            "user_id": str(user_id),
            "revoked": False,
            "created_at": datetime.now(timezone.utc).isoformat(),
        }
        if self._is_mongo():
            db.collection_insert_one(REFRESH_COLLECTION, row)
            return
        db.execute(
            "INSERT INTO _tpy_refresh_tokens (jti, user_id, revoked, created_at) "
            "VALUES (?, ?, ?, ?)",
            (row["jti"], row["user_id"], 0, row["created_at"]),
        )

    def _is_refresh_active(self, jti: str) -> bool:
        self._ensure_refresh_store()
        if self._is_mongo():
            row = db.collection_find_one(REFRESH_COLLECTION, {"jti": jti})
            return bool(row) and not row.get("revoked")
        row = db.fetch_one(
            "SELECT jti, revoked FROM _tpy_refresh_tokens WHERE jti = ?",
            (jti,),
        )
        return row is not None and not bool(row.get("revoked"))

    def _revoke_refresh(self, jti: str) -> None:
        self._ensure_refresh_store()
        if self._is_mongo():
            existing = db.collection_find_one(REFRESH_COLLECTION, {"jti": jti})
            if existing is None:
                return
            db.collection_update_one(
                REFRESH_COLLECTION,
                {"jti": jti},
                {"revoked": True},
            )
            return
        db.execute(
            "UPDATE _tpy_refresh_tokens SET revoked = 1 WHERE jti = ?",
            (jti,),
        )

    def _role_name(self, user: dict) -> str:
        role = self._find_role_by_id(str(user.get("role_id", "")))
        if role is None:
            return "admin"
        return str(role.get("name") or "admin")

    def _token_pair(self, user: dict) -> dict:
        role = self._role_name(user)
        access = create_access_token(str(user["id"]), role)
        refresh, jti = create_refresh_token(str(user["id"]))
        self._store_refresh(jti, str(user["id"]))
        return {
            "access_token": access,
            "refresh_token": refresh,
            "token_type": "bearer",
            "expires_in": access_expires_seconds(),
        }

    def _public_user(self, user: dict) -> dict:
        return {
            "id": str(user.get("id")),
            "name": user.get("name"),
            "email": user.get("email"),
            "role_id": str(user.get("role_id")) if user.get("role_id") else None,
            "role": self._role_name(user),
        }

    def register(self, name: str, email: str, password: str) -> dict:
        """Create a user with default ``admin`` role and return tokens."""
        if self._find_user_by_email(email) is not None:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Email already registered",
            )

        role = self._find_role_by_name(DEFAULT_REGISTER_ROLE)
        if role is None:
            raise HTTPException(
                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
                detail="Auth roles not seeded. Run: tpy seed",
            )

        user = self._create_user(
            {
                "id": str(uuid4()),
                "name": name,
                "email": email,
                "password": hash_password(password),
                "role_id": str(role["id"]),
            }
        )
        if user is None:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Unable to register user",
            )
        return self._token_pair(user)

    def login(self, email: str, password: str) -> dict:
        """Validate credentials and return a token pair."""
        user = self._find_user_by_email(email)
        if user is None or not verify_password(password, str(user.get("password", ""))):
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Invalid email or password",
            )
        return self._token_pair(user)

    def refresh(self, refresh_token: str) -> dict:
        """Rotate tokens using a valid refresh JWT."""
        try:
            payload = decode_token(refresh_token)
        except jwt.PyJWTError:
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Invalid refresh token",
            )

        if payload.get("type") != "refresh":
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Refresh token required",
            )

        jti = str(payload.get("jti", ""))
        if not jti or not self._is_refresh_active(jti):
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Refresh token revoked or unknown",
            )

        user = self._find_user_by_id(str(payload.get("sub", "")))
        if user is None:
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="User not found",
            )

        self._revoke_refresh(jti)
        return self._token_pair(user)

    def logout(self, refresh_token: str) -> dict:
        """Revoke a refresh token."""
        try:
            payload = decode_token(refresh_token)
        except jwt.PyJWTError:
            return {"revoked": True}

        if payload.get("type") == "refresh" and payload.get("jti"):
            self._revoke_refresh(str(payload["jti"]))
        return {"revoked": True}

    def me(self, user_id: str) -> dict:
        """Return the public profile for a user id."""
        user = self._find_user_by_id(user_id)
        if user is None:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="User not found",
            )
        return self._public_user(user)
